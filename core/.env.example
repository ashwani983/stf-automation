# Copy to `.env` on the core host (this file is committed; `.env` is not).
#
#   cp .env.example .env && $EDITOR .env

# The address the BROWSER is told to use - for the panel, for the core's
# redirects, and for the websocket URL. This is `--public-ip`, not a bind
# address, so it must be reachable from EVERY host that opens the panel, not
# just the ones on the core's own network.
#
# On the Proxmox core, use Proxmox's WireGuard mesh address (10.8.0.5), which
# the host DNATs to the container. The container's fast-cable address
# (10.10.10.3) is only routable from the two hosts actually on that cable; if
# you set STF_IP to it, the panel will load elsewhere but the websocket
# (ws://10.10.10.3:7110) will fail with "WebSocket is closed before the
# connection is established", because mesh peers hand 10.10.10.3 to the hub,
# which has no route for it.
STF_IP=10.8.0.5

# Ports published on the container
STF_WEB_PORT=7100
STF_WS_PORT=7110
STF_DEV_PUB_PORT=7114
STF_DEV_PULL_PORT=7116

GROUP_TIMEOUT=900
TZ=Asia/Kolkata

# Root admin. STF_ADMIN_EMAIL must be a valid email with a TLD, or the mock
# login validator rejects it at login time.
STF_ADMIN_EMAIL=admin@example.com
STF_ADMIN_NAME=Admin

# Signs session cookies. Generate your own:
#   openssl rand -hex 24
STF_AUTH_SECRET=change-me-generate-a-random-secret

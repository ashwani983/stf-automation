# Provider-only env for the Windows PC.
# The core moved to Proxmox (../core/); this host just contributes its phone.

# This host's mesh address (the "gamepc" tunnel). STF advertises streaming URLs
# on this IP so the browser can pull the device stream straight from this PC.
SELF_IP=10.8.0.4

# The core, reachable over the WireGuard mesh at Proxmox's mesh address.
# Proxmox DNATs 7100/7110/7114/7116 to the stf-core container on its cable.
CORE_IP=10.8.0.5

# Provider stream ports on this host.
PROVIDER_MIN_PORT=7400
PROVIDER_MAX_PORT=7500

# Where the provider finds adb.
#
# Use this host's CONCRETE address, not host.docker.internal: inside the
# container that name resolves to IPv6 (the Docker VM), which runs its own empty
# adb server, so the provider sees zero devices.
#
# For the container to reach it, adb must listen on 0.0.0.0 (start.ps1 starts it
# with `adb -a`), and the Windows firewall must allow inbound 5037 from the
# container networks (allow-container-adb.ps1).
ADB_HOST=10.8.0.4
ADB_PORT=5037

# Devices shared by another host over the network, re-attached by start.ps1.
# STF ignores these unless provider-compose.yml passes --allow-remote.
# Comma-separated; leave empty if this host has only USB phones.
NETWORK_DEVICES=10.8.0.2:34571

GROUP_TIMEOUT=900
TZ=Asia/Kolkata

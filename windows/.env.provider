# Provider-only env for the Windows PC.
# The core moved to Proxmox (../core/); this host just contributes its phone.

# This host's mesh address (the "gamepc" tunnel). STF advertises streaming URLs
# on this IP so the browser can pull the device stream straight from this PC.
SELF_IP=10.8.0.4

# The core, reachable over the WireGuard mesh at Proxmox's mesh address.
# Proxmox DNATs 7100/7110/7114/7116 to the stf-core container on its cable.
CORE_IP=10.8.0.5

# Provider stream ports on this host.
PROVIDER_MIN_PORT=7400
PROVIDER_MAX_PORT=7500

# Where the provider finds adb. On Docker Desktop, host.docker.internal points
# at this Windows machine, whose adb server runs on 0.0.0.0:5037.
ADB_HOST=host.docker.internal
ADB_PORT=5037

GROUP_TIMEOUT=900
TZ=Asia/Kolkata
